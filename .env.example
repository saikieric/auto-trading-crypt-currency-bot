# bitFlyer
BITFLYER_API_KEY=your_bitflyer_api_key
BITFLYER_API_SECRET=your_bitflyer_api_secret

# GMOコイン
GMO_API_KEY=your_gmo_api_key
GMO_API_SECRET=your_gmo_api_secret

# Bitbank
BITBANK_API_KEY=your_bitbank_api_key
BITBANK_API_SECRET=your_bitbank_api_secret

# Discord Webhook（通知送信用）
# チャンネル設定 → 連携サービス → Webhookを作成 → URLをコピー
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/xxxxxxxxxxxxxxxx

# Discord Bot（コマンド操作用: /status /stop /start /config）
# https://discord.com/developers/applications でBotを作成してTokenを取得
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_here
DISCORD_COMMAND_CHANNEL_ID=your_channel_id_here
